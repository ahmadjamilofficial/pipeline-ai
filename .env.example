# .env.example — copy to .env and fill in values before running locally.
# cp .env.example .env
#
# None of these values are required for `make test-unit` (unit tests use
# embedded stubs). They are needed for `make test-postgres` or running a
# live Coder server.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Leave empty to use the built-in embedded
# Postgres instance (downloaded automatically on first run).
CODER_PG_CONNECTION_URL=

# ── Server ────────────────────────────────────────────────────────────────────
# Externally reachable URL for this Coder deployment (required in production).
CODER_ACCESS_URL=http://localhost:3000

# ── GitHub OAuth2 (optional) ──────────────────────────────────────────────────
# Register an OAuth app at https://github.com/settings/developers
CODER_OAUTH2_GITHUB_CLIENT_ID=
CODER_OAUTH2_GITHUB_CLIENT_SECRET=

# ── OIDC (optional) ───────────────────────────────────────────────────────────
CODER_OIDC_CLIENT_ID=
CODER_OIDC_CLIENT_SECRET=
CODER_OIDC_ISSUER_URL=

# ── AI / LLM integrations (optional) ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── OAuth2 test server (scripts/oauth2/oauth2-test-server.go) ─────────────────
# These are only needed when running the manual OAuth2 test flow.
# Run: eval $(./scripts/oauth2/setup-test-app.sh) to populate them.
CLIENT_ID=
CLIENT_SECRET=
CODE_VERIFIER=
STATE=

# ── Development helpers ───────────────────────────────────────────────────────
# Password for the admin account created by scripts/develop.sh.
# If unset, a random password is generated and printed at startup.
CODER_DEV_ADMIN_PASSWORD=
