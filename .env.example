# .env.example — copy to .env and fill in values before running locally.
# cp .env.example .env
#
# None of these values are required for `make test-unit` (unit tests use
# embedded stubs). They are needed for `make test-postgres` or running a
# live Coder server.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Leave empty to use the built-in embedded
# Postgres instance (downloaded automatically on first run).
CODER_PG_CONNECTION_URL=

# Template database name used by dbtestutil when running integration tests.
# Set to an existing database to clone from it instead of running migrations.
DB_FROM=

# ── Server ────────────────────────────────────────────────────────────────────
# Externally reachable URL for this Coder deployment (required in production).
CODER_ACCESS_URL=http://localhost:3000

# Enable verbose/debug logging.
CODER_VERBOSE=false

# ── Telemetry ─────────────────────────────────────────────────────────────────
# Opt out of anonymous usage telemetry sent to telemetry.coder.com.
CODER_TELEMETRY_ENABLE=true
CODER_TELEMETRY=true

# Source tag included in telemetry (e.g. aws_marketplace, docker).
CODER_TELEMETRY_INSTALL_SOURCE=

# ── Tracing ───────────────────────────────────────────────────────────────────
# Enable OpenTelemetry trace export.
CODER_TRACE_ENABLE=false
CODER_TRACE_HONEYCOMB_API_KEY=
CODER_TRACE_LOGS=false
CODER_TRACE_DATADOG=false

# ── GitHub OAuth2 (optional) ──────────────────────────────────────────────────
# Register an OAuth app at https://github.com/settings/developers
CODER_OAUTH2_GITHUB_CLIENT_ID=
CODER_OAUTH2_GITHUB_CLIENT_SECRET=

# ── OIDC (optional) ───────────────────────────────────────────────────────────
CODER_OIDC_CLIENT_ID=
CODER_OIDC_CLIENT_SECRET=
CODER_OIDC_ISSUER_URL=

# ── AI / LLM integrations (optional) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
# Anthropic model override (defaults to claude-3-5-sonnet if unset).
ANTHROPIC_MODEL=

# ── E2E / Playwright tests (site/e2e/) ───────────────────────────────────────
# Premium license key required to run license-gated E2E tests.
CODER_E2E_LICENSE=

# Port the Coder server listens on during E2E tests (default 3111).
CODER_E2E_PORT=3111

# Set to true to require premium E2E tests to run (fails if no license).
CODER_E2E_REQUIRE_PREMIUM_TESTS=false

# Set to true to skip Terraform-based E2E tests (useful without Docker).
CODER_E2E_DISABLE_TERRAFORM=false

# Number of times to retry a failing E2E test.
CODER_E2E_TEST_RETRIES=

# WebSocket endpoint for Playwright browser (leave empty for default).
CODER_E2E_WS_ENDPOINT=

# ── OAuth2 test server (scripts/oauth2/oauth2-test-server.go) ─────────────────
# These are only needed when running the manual OAuth2 test flow.
# Run: eval $(./scripts/oauth2/setup-test-app.sh) to populate them.
CLIENT_ID=
CLIENT_SECRET=
CODE_VERIFIER=
STATE=

# ── Development helpers ───────────────────────────────────────────────────────
# Password for the admin account created by scripts/develop.sh.
# If unset, a random password is generated at startup and printed to stdout.
# You can also load this from a local .env file using direnv:
#   echo 'dotenv' > .envrc && direnv allow
CODER_DEV_ADMIN_PASSWORD=
